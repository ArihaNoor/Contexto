# Copy to .env and fill in. Only the token is required.

# Hugging Face access token — https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=hf_your_token_here

# --- Optional overrides (defaults shown) ---

# Any chat-completion model served by a provider enabled on your HF account.
# LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# LLM_TEMPERATURE=0.5
# LLM_MAX_TOKENS=512

# Runs locally on CPU via fastembed — no API calls, no torch.
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Ingestion / retrieval tuning
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# TOP_K=4
# MAX_FILE_SIZE_MB=20

# Storage / logging
# CHROMA_DIR=./chroma_db
# LOG_LEVEL=INFO
