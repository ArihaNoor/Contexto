# Copy to .env and pick ONE provider below.
# Embeddings always run locally on CPU — they never need a key.

# --- Option A: Hugging Face Inference (hosted, free tier) ---
LLM_PROVIDER=huggingface
HUGGINGFACEHUB_API_TOKEN=hf_your_token_here
# LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# --- Option B: Ollama (fully local, zero cost, no key) ---
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2

# --- Option C: OpenAI ---
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# --- Option D: Google Gemini (OpenAI-compatible endpoint) ---
# LLM_PROVIDER=gemini
# LLM_API_KEY=your_gemini_key
# LLM_MODEL=gemini-2.0-flash

# --- Option E: anything else that speaks OpenAI /chat/completions ---
# (vLLM, LM Studio, OpenRouter, Together, ...)
# LLM_BASE_URL=https://your-endpoint/v1
# LLM_API_KEY=...
# LLM_MODEL=...

# --- Optional tuning (defaults shown) ---
# LLM_TEMPERATURE=0.5
# LLM_MAX_TOKENS=512
# LLM_TIMEOUT_SECONDS=60
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# TOP_K=4
# MAX_FILE_SIZE_MB=20
# CHROMA_DIR=./chroma_db
# LOG_LEVEL=INFO
